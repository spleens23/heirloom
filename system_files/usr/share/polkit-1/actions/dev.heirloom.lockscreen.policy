<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Heirloom</vendor>
  <action id="dev.heirloom.lockscreen">
    <description>Change your passcode or lock-screen picture</description>
    <message>Heirloom needs to change your passcode or lock-screen picture</message>
    <icon_name>system-lock-screen</icon_name>
    <defaults>
      <!-- The helper checks your current password itself before changing the passcode. -->
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/heirloom-lockscreen</annotate>
  </action>
</policyconfig>
