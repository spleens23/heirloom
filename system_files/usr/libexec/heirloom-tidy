#!/usr/bin/env bash
# Small fix-ups Heirloom checks on every start. Each one is quick and does nothing
# once it's done.
set -uo pipefail

# 1. Keep the boot menu out of sight (see /usr/share/heirloom/grub-quiet.cfg).
#    GRUB reads /boot/grub2/custom.cfg after its own settings, so this overrides
#    the one-second menu that Fedora's image-based systems show by default.
quiet_boot() {
    local src=/usr/share/heirloom/grub-quiet.cfg dst=/boot/grub2/custom.cfg remounted=0
    [ -d /boot/grub2 ] || return 0
    cmp -s "$src" "$dst" 2>/dev/null && return 0
    if ! touch /boot/grub2/.heirloom-rw 2>/dev/null; then
        mount -o remount,rw /boot && remounted=1 || return 1
    else
        rm -f /boot/grub2/.heirloom-rw
    fi
    install -m 0644 "$src" "$dst"
    sync
    [ "$remounted" = 1 ] && mount -o remount,ro /boot
    return 0
}
quiet_boot || echo "heirloom-tidy: couldn't hide the boot menu" >&2

# 2. Heirloom has its own Weather app (it searches any city); GNOME's, which an
#    earlier Heirloom installed, can go.
if command -v flatpak >/dev/null && flatpak info --system org.gnome.Weather >/dev/null 2>&1; then
    flatpak uninstall --system --noninteractive -y org.gnome.Weather || true
fi
exit 0
