#!/usr/bin/python3
"""heirloom-update: update Heirloom over the internet or from a USB stick.

  heirloom-update status        what's installed, and what's waiting for a restart
  heirloom-update check         is there a newer Heirloom online?
  heirloom-update apply         download the newest Heirloom (takes effect on restart)
  heirloom-update usb [FILE]    install an update file from a USB stick
  heirloom-update rollback      go back to the previous version (on restart)
  heirloom-update restart       restart now to finish

Add --json to status or check for machine-readable output (used by the
Software Update app). Your files and Flatpak apps are never touched.
"""

from __future__ import annotations

import glob
import hashlib
import json
import os
import subprocess
import sys

IMAGE = "ghcr.io/spleens23/heirloom:latest"
PRIVILEGED = {"apply", "usb", "rollback", "track-github"}


def say(msg: str) -> None:
    print(msg, flush=True)


def fail(msg: str, code: int = 1) -> None:
    print(f"Error: {msg}", file=sys.stderr, flush=True)
    sys.exit(code)


def elevate(args: list[str]) -> None:
    """Re-run as root, asking for your password through the system prompt."""
    if os.geteuid() != 0:
        os.execvp("pkexec", ["pkexec", os.path.realpath(sys.argv[0]), *args])


def run(cmd: list[str]) -> int:
    """Run a command, passing its output straight through."""
    return subprocess.call(cmd)


# ---- reading the current state --------------------------------------------

def deployments() -> list[dict]:
    out = subprocess.run(["rpm-ostree", "status", "--json"],
                         capture_output=True, text=True, check=True).stdout
    return json.loads(out).get("deployments", [])


def describe(d: dict | None) -> dict | None:
    if not d:
        return None
    return {
        "version": d.get("version") or "",
        "timestamp": d.get("timestamp") or 0,
        "digest": d.get("container-image-reference-digest") or "",
        "ref": d.get("container-image-reference") or d.get("origin") or "",
    }


def status() -> dict:
    deps = deployments()
    booted = next((d for d in deps if d.get("booted")), None)
    # rpm-ostree lists the one that starts next first. If that isn't the
    # running one, a change (update, USB install or undo) waits for a restart.
    pending = deps[0] if deps and not deps[0].get("booted") else None
    others = [d for d in deps if not d.get("booted") and d is not pending]
    return {
        "booted": describe(booted),
        "pending": describe(pending),
        "rollback": bool(others),
        "tracks_github": bool(booted and IMAGE in (booted.get("container-image-reference") or "")),
    }


def remote_digest() -> str | None:
    try:
        out = subprocess.run(
            ["skopeo", "inspect", "--no-creds", "--format", "{{.Digest}}", f"docker://{IMAGE}"],
            capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


def check() -> dict:
    st = status()
    remote = remote_digest()
    if not remote:
        return {"state": "offline"}
    pending = st["pending"]
    booted = st["booted"]
    if pending and pending["digest"] == remote:
        state = "ready"
    elif booted and booted["digest"] == remote:
        state = "current"
    else:
        state = "available"
    return {"state": state, "remote": remote}


# ---- commands ------------------------------------------------------------------

def cmd_status(as_json: bool) -> None:
    st = status()
    if as_json:
        say(json.dumps(st))
        return
    b = st["booted"] or {}
    say(f"Running:  Heirloom {b.get('version') or '(unknown version)'}")
    if st["pending"]:
        say(f"Waiting:  Heirloom {st['pending']['version'] or '(new version)'} starts after you restart")
    say(f"Undo available: {'yes' if st['rollback'] else 'no'}")
    if not st["tracks_github"]:
        say("Updates source will be reset to GitHub on the next restart.")


def cmd_check(as_json: bool) -> None:
    res = check()
    if as_json:
        say(json.dumps(res))
        return
    say({
        "offline": "Couldn't reach the update server. Check your internet connection.",
        "current": "Heirloom is up to date.",
        "available": "A new version of Heirloom is available. Run: heirloom-update apply",
        "ready": "The newest Heirloom is downloaded. Restart to finish: heirloom-update restart",
    }[res["state"]])


def cmd_apply() -> None:
    say("Downloading the newest Heirloom…")
    if run(["bootc", "upgrade"]) != 0:
        fail("The update didn't download. Check your connection and try again.")
    say("Done. Restart to finish updating.")


def find_usb_file() -> str | None:
    user = os.environ.get("USER") or ""
    roots = [f"/run/media/{user}", "/run/media", "/media", "/mnt"]
    for root in roots:
        hits = sorted(glob.glob(os.path.join(root, "**", "heirloom-update-*.ociarchive"), recursive=True))
        if hits:
            return hits[-1]  # newest by name (names carry the date)
    return None


def verify(path: str) -> None:
    sums = os.path.join(os.path.dirname(path), "SHA256SUMS")
    if not os.path.exists(sums):
        say("No SHA256SUMS file next to the update, so skipping the integrity check.")
        return
    want = None
    with open(sums) as f:
        for line in f:
            parts = line.split()
            if len(parts) == 2 and os.path.basename(parts[1].lstrip("*")) == os.path.basename(path):
                want = parts[0].lower()
    if not want:
        say("SHA256SUMS doesn't list this file, so skipping the integrity check.")
        return
    size = os.path.getsize(path)
    h = hashlib.sha256()
    done = last = 0
    with open(path, "rb") as f:
        while chunk := f.read(8 * 1024 * 1024):
            h.update(chunk)
            done += len(chunk)
            pct = done * 100 // max(size, 1)
            if pct >= last + 10:
                last = pct - pct % 10
                say(f"Checking the file… {last}%")
    if h.hexdigest() != want:
        fail("This update file is damaged or incomplete. Copy it to the USB stick again.")
    say("The file checks out.")


def cmd_usb(path: str | None) -> None:
    if not path:
        fail("No update file found. Plug in the USB stick, or pass the file's path.")
    path = os.path.abspath(path)
    if not os.path.isfile(path):
        fail(f"Can't find {path}")
    say(f"Using {os.path.basename(path)}")
    verify(path)
    say("Installing the update from the USB stick…")
    if run(["bootc", "switch", "--transport", "oci-archive", path]) != 0:
        fail("Installing from the USB stick didn't work.")
    say("Done. Restart to finish updating. You can unplug the USB stick after restarting.")


def cmd_rollback() -> None:
    if run(["bootc", "rollback"]) != 0:
        fail("There's no earlier version to go back to.")
    say("Done. Your previous version of Heirloom starts the next time you restart.")


def cmd_track_github() -> None:
    """Runs at every boot: after a USB update, point updates back at GitHub.

    This only changes where future updates come from; nothing is downloaded.
    """
    if os.path.exists("/etc/heirloom/no-track"):
        return
    deps = deployments()
    booted = next((d for d in deps if d.get("booted")), None)
    if booted and IMAGE in (booted.get("container-image-reference") or ""):
        return
    run(["bootc", "switch", "--mutate-in-place", "--transport", "registry", IMAGE])


def main(argv: list[str]) -> None:
    args = [a for a in argv if a != "--json"]
    as_json = "--json" in argv
    if not args or args[0] in ("-h", "--help", "help"):
        say(__doc__.strip())
        return
    cmd, rest = args[0], args[1:]

    if cmd == "usb" and not rest:
        # Find the file now, while we still know whose USB stick is plugged in.
        found = find_usb_file()
        rest = [found] if found else []
    if cmd in PRIVILEGED:
        elevate([cmd, *rest] + (["--json"] if as_json else []))

    if cmd == "status":
        cmd_status(as_json)
    elif cmd == "check":
        cmd_check(as_json)
    elif cmd == "apply":
        cmd_apply()
    elif cmd == "usb":
        cmd_usb(rest[0] if rest else None)
    elif cmd == "rollback":
        cmd_rollback()
    elif cmd == "restart":
        os.execvp("systemctl", ["systemctl", "reboot"])
    elif cmd == "track-github":
        cmd_track_github()
    else:
        fail(f"Unknown command '{cmd}'. Run heirloom-update --help.")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except subprocess.CalledProcessError as e:
        fail(f"{' '.join(e.cmd)} failed")
