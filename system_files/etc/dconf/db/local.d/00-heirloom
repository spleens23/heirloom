# Heirloom's default settings. Anything you change in Settings overrides these.

[org/gnome/shell]
enabled-extensions=['harbor-tablet@harbor.dev', 'heirloom-keypad@heirloom.dev']
favorite-apps=['dev.spectacle.Spectacle.desktop', 'dev.screenroom.Screenroom.desktop', 'dev.screenroom.Parlor.desktop', 'org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'com.valvesoftware.Steam.desktop', 'org.gnome.Ptyxis.desktop']
welcome-dialog-last-shown-version='999'

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/heirloom/sky.svg'
picture-uri-dark='file:///usr/share/backgrounds/heirloom/sky.svg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/heirloom/sky.svg'
picture-options='zoom'

[org/gnome/desktop/interface]
color-scheme='default'
accent-color='blue'
clock-format='12h'
clock-show-weekday=true
clock-show-date=true
show-battery-percentage=true

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
